    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RentACar.MVC/**" />
    <Content Remove="RentACar.MVC/**" />
