@section Scripts {
<style>
    .branch-card{background:#fff;border-radius:8px;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.08);transition:transform .25s;height:100%;position:relative;overflow:hidden}
    .branch-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.14)}
    .branch-city-tag{position:absolute;top:0;right:0;background:var(--primary);color:#fff;font-size:.7rem;font-weight:700;padding:4px 14px;border-radius:0 8px 0 8px;text-transform:uppercase;letter-spacing:.5px}
    .branch-icon{width:48px;height:48px;background:#fff4ee;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;color:var(--primary);flex-shrink:0}
    .branch-badge{font-size:.7rem;font-weight:700;padding:3px 10px;border-radius:50px}
    .branch-badge.open{background:#dcfce7;color:#166534}
    .branch-badge.closed{background:#fef9c3;color:#854d0e}
    .branch-info{display:flex;flex-direction:column;gap:8px}
    .branch-info-row{display:flex;align-items:flex-start;gap:8px;font-size:.85rem;color:#555}
    .branch-info-row i{color:var(--primary);flex-shrink:0;margin-top:2px}
    .branch-filter{background:transparent;border:2px solid #e2e8f0;border-radius:50px;padding:6px 18px;font-weight:600;font-size:.85rem;color:#555;cursor:pointer;transition:all .2s;white-space:nowrap}
    .branch-filter.active,.branch-filter:hover{background:var(--primary);border-color:var(--primary);color:#fff}
</style>
<script>
    function filterBranch(btn, city) {
        document.querySelectorAll('.branch-filter').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('.branch-item').forEach(function(item) {
            item.style.display = (city === 'all' || item.dataset.city === city) ? '' : 'none';
        });
    }

    // URL'den şehir parametresi varsa filtrele
    var cityParam = new URLSearchParams(window.location.search).get('city');
    if (cityParam) {
        var btn = document.querySelector('.branch-filter[onclick*="' + cityParam + '"]');
        if (btn) filterBranch(btn, cityParam);
    }
</script>
}
