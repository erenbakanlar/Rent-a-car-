            <div class="col-md-3 col-sm-6">
                <div class="text-center p-4 bg-white rounded shadow-sm">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold text-white fs-4"
                         style="width:80px;height:80px;border-radius:50%;background:var(--dark-bg);border:3px solid var(--primary)">MC</div>
                    <h6 class="fw-bold mb-1">Mehmet Çelik</h6>
                    <p class="text-muted small mb-2">Teknik Direktör</p>
