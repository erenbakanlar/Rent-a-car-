@{
    ViewData["Title"] = "Hakkımızda";
}

<!-- PAGE HEADER -->
<div style="background:var(--dark-bg);padding:4rem 0 3rem;border-bottom:4px solid var(--primary)">
    <div class="container">
        <p class="text-uppercase fw-bold mb-2" style="color:var(--primary);letter-spacing:2px;font-size:.8rem">
            <i class="bi bi-house me-1"></i>Ana Sayfa &rsaquo; Hakkımızda
        </p>
        <h1 class="text-white fw-bold mb-2" style="font-size:2.5rem">Hakkımızda</h1>
        <p class="text-white-50 mb-0">Türkiye'nin güvenilir araç kiralama platformu</p>
    </div>
</div>

<!-- WHO WE ARE -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="section-title mb-0">Biz <span>Kimiz?</span></h2>
                <div class="section-divider"></div>
                <p class="text-muted mb-3">
                    RentACar, 2020 yılında Türkiye'nin dört bir yanında güvenli ve uygun fiyatlı araç kiralama hizmeti sunmak amacıyla kurulmuştur.
                    Müşteri memnuniyetini her şeyin önünde tutan anlayışımızla, binlerce müşteriye hizmet vermenin gururunu yaşıyoruz.
                </p>
                <p class="text-muted mb-4">
                    Ekonomi sınıfından premium araçlara kadar geniş filomuzla, iş seyahatinden tatil gezisine her ihtiyaca uygun çözümler sunuyoruz.
                    Dijital altyapımız sayesinde rezervasyon işlemlerinizi dakikalar içinde tamamlayabilirsiniz.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#fff4ee;border-left:4px solid var(--primary)">
                            <div class="fw-bold fs-4" style="color:var(--primary)">5.000+</div>
                            <div class="text-muted small">Mutlu Müşteri</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#fff4ee;border-left:4px solid var(--primary)">
                            <div class="fw-bold fs-4" style="color:var(--primary)">18+</div>
                            <div class="text-muted small">Araç Seçeneği</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#fff4ee;border-left:4px solid var(--primary)">
                            <div class="fw-bold fs-4" style="color:var(--primary)">81</div>
                            <div class="text-muted small">İlde Hizmet</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#fff4ee;border-left:4px solid var(--primary)">
                            <div class="fw-bold fs-4" style="color:var(--primary)">7/24</div>
                            <div class="text-muted small">Müşteri Desteği</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="rounded overflow-hidden" style="background:var(--dark-bg);height:380px;display:flex;align-items:center;justify-content:center;border:3px solid var(--primary)">
                    <div class="text-center p-4">
                        <i class="bi bi-car-front-fill" style="font-size:6rem;color:var(--primary)"></i>
                        <h3 class="text-white fw-bold mt-3">RentACar</h3>
                        <p class="text-white-50">Güvenli · Hızlı · Uygun Fiyatlı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MISSION & VISION -->
<section class="py-5" style="background:#f8f9fa">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Misyon & <span>Vizyon</span></h2>
            <div class="section-divider mx-auto"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="why-card h-100">
                    <div class="icon-wrap"><i class="bi bi-bullseye"></i></div>
                    <h5 class="fw-bold mb-3">Misyonumuz</h5>
                    <p class="text-muted mb-0">
                        Müşterilerimize en kaliteli araçları, en uygun fiyatlarla ve en hızlı şekilde ulaştırmak.
                        Her yolculuğu güvenli, konforlu ve keyifli kılmak için çalışıyoruz.
                        Teknoloji ve insan odaklı hizmet anlayışımızla sektörde fark yaratıyoruz.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="why-card h-100">
                    <div class="icon-wrap"><i class="bi bi-eye"></i></div>
                    <h5 class="fw-bold mb-3">Vizyonumuz</h5>
                    <p class="text-muted mb-0">
                        Türkiye'nin en çok tercih edilen dijital araç kiralama platformu olmak.
                        Sürdürülebilir ulaşım çözümleri sunarak çevreye duyarlı bir gelecek inşa etmek.
                        Elektrikli ve hibrit araç filomuzla yeşil mobiliteye öncülük etmek.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

